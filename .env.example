NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Providers (au moins un requis) ───────────────────────────────────────
# Priorité : Gemini Flash → Claude Sonnet → OpenAI (fallback)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (gratuit + quota généreux)
ANTHROPIC_API_KEY=       # https://console.anthropic.com/
OPENAI_API_KEY=          # legacy fallback

# ─── Pipeline & Cron ─────────────────────────────────────────────────────────
PIPELINE_SECRET=changeme_pipeline   # Token pour sécuriser /api/pipeline/* et /api/auto-optimize

# ─── Media ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Paid (à configurer plus tard) ───────────────────────────────────────────
# ELEVENLABS_API_KEY=    # https://elevenlabs.io  ($22/mois Creator)
# KLING_API_KEY=         # https://klingai.com    (pay-per-use $0.03/sec)
# AYRSHARE_API_KEY=      # https://ayrshare.com   ($29/mois TikTok+IG+Pinterest)
# FLUX_API_KEY=          # https://bfl.ai         ($0.04/image)

# ─── Admin & Config ──────────────────────────────────────────────────────────
ADMIN_SECRET=changeme
ADMIN_SALT=changeme_salt       # sel pour le hash du cookie admin (lib/admin-auth.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sprint 3 : sources de données étude de marché (toutes optionnelles,
#     désactivées par défaut — ajouter la clé PUIS activer dans
#     /admin/settings/integrations) ──────────────────────────────────────
KEEPA_API_KEY=                  # https://keepa.com/#!api — ~19€/mois
DATAFORSEO_LOGIN=               # https://dataforseo.com — ~25€/mois selon volume
DATAFORSEO_PASSWORD=
AMAZON_CREATORS_CREDENTIAL_ID=  # https://affiliate-program.amazon.fr/creatorsapi — gratuit, 10 ventes qualifiées/30j requises
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_AFFILIATE_TAG=            # tag d'affiliation Amazon (ex. tendpick-21), utilisé par le scraping de secours
AWIN_API_TOKEN=                 # https://ui.awin.com — gratuit
RAKUTEN_API_TOKEN=              # https://rakutenadvertising.com — gratuit
RAKUTEN_MERCHANT_ID_FR=
RAKUTEN_MERCHANT_ID_ES=
RAKUTEN_MERCHANT_ID_UK=
CJ_API_TOKEN=                   # https://developers.cj.com — gratuit
CJ_WEBSITE_ID=
ALIEXPRESS_APP_KEY=             # https://developers.aliexpress.com — gratuit
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
SERPAPI_API_KEY=                # https://serpapi.com — optionnel, payant
JUNGLESCOUT_KEY_NAME=           # https://developer.junglescout.com — optionnel Phase 2, payant
JUNGLESCOUT_API_KEY=
CANOPY_API_KEY=                 # https://canopyapi.co — optionnel, payant

# ─── Sprint 2 : facturation — coordonnées légales de l'émetteur (module
#     factures/avoirs du Répertoire). Aucune valeur par défaut fournie :
#     tant que ce n'est pas rempli, le PDF l'affiche en warning plutôt que
#     d'imprimer un faux SIRET/NIF. ───────────────────────────────────────
INVOICE_ISSUER_NAME=            # raison sociale exacte
INVOICE_ISSUER_ADDRESS=         # adresse complète affichée sur les factures
INVOICE_ISSUER_REG_NUMBER=      # SIRET (FR) / NIF (ES) / company number (UK)
INVOICE_ISSUER_VAT_NUMBER=      # laisser vide si franchise en base / exonéré
INVOICE_ISSUER_EMAIL=

# ─── Brevo (capture de leads, envoi transactionnel, module nurture,
#     envoi manuel depuis le Répertoire de contacts) ─────────────────────
BREVO_API_KEY=                  # https://app.brevo.com/settings/keys/api — requis pour tout envoi Brevo
BREVO_LIST_ID_FR=               # liste Brevo "leads FR" (capture publique, app/api/leads/route.ts)
BREVO_LIST_ID_ES=
BREVO_LIST_ID_UK=
# contact@tendpick.com est l'expéditeur vérifié (domaine tendpick.com
# authentifié DKIM+DMARC côté Brevo depuis le 22/09) pour l'envoi manuel
# de mails aux contacts du Répertoire (app/api/leads/[id]/send-email).

# ─── Module nurture email (rapport 18/09, étape 3) — une liste Brevo par
#     marché, séparée de BREVO_LIST_ID_FR/ES/UK (déjà utilisée par la
#     capture de leads) : ne jamais réutiliser cette dernière ici, pour ne
#     pas mélanger « vient de s'inscrire » et « en cours de relance ».
#     Sans ces variables, le panneau Admin > Relance email affiche un
#     avertissement et bloque l'inscription pour le(s) marché(s) concerné(s).
NURTURE_LIST_ID_FR=
NURTURE_LIST_ID_ES=
NURTURE_LIST_ID_UK=

# ─── Sprint 3 : canaux de diffusion réseaux sociaux (optionnels) ─────────
POSTIZ_INSTANCE_URL=            # instance Postiz (self-hosted, ou https://api.postiz.com en cloud)
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID=          # id du compte connecté ciblé (GET {instance}/public/v1/integrations) — requis, corrige le bug audit 21/09
AYRSHARE_API_KEY=               # https://ayrshare.com — ~29$/mois
TIKTOK_CLIENT_KEY=              # https://developers.tiktok.com — gratuit, audit compte 2-6 semaines
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
META_PAGE_ACCESS_TOKEN=         # https://developers.facebook.com — gratuit, vérification business requise
META_PAGE_ID=

# ─── Sprint 0 : cron interne (market refresh 6h/marché, exchange-rates quotidien — Sprint 4/5) ───
INTERNAL_CRON_SECRET=changeme

# ─── Sprint 5 : taux de change EUR<->GBP pour le coût/gain UK ───────────
# Aucune clé requise — frankfurter.app est gratuit et public.
# app/api/cron/exchange-rates l'appelle directement.

# ─── Pipeline Keepa/PostgreSQL autonome (lib/db.ts, lib/keepa.ts,
#     app/api/sync/*, app/api/scores/*, app/api/track/*) — système de
#     sync prix/dispo indépendant du registre d'intégrations Sprint 3
#     ci-dessus. Ne partage ni ses codes marché ni ses clés d'auth. ────────
DATABASE_URL=                   # Supabase Session pooler (port 5432, PAS le Transaction pooler 6543)
INTERNAL_API_KEY=changeme_internal   # auth interne pour /api/sync/*, /api/scores/* (≠ INTERNAL_CRON_SECRET ci-dessus)
SERPAPI_KEY=                    # Google Trends pour ce pipeline (≠ SERPAPI_API_KEY du registre Sprint 3 — même service, clé séparée)
ADMIN_EMAIL=                    # destinataire des alertes de baisse de prix (lib/opf-notify.ts)
ONESIGNAL_API_KEY=              # push web — optionnel, non branché ("coming soon" dans le code)
ONESIGNAL_APP_ID=
