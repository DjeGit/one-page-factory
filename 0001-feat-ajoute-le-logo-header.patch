+          aria-label="Tendpick, accueil"
+          className="flex items-center gap-2 shrink-0 -ml-1 sm:-ml-1.5"
+        >
+          <LogoMark />
+          <span className="font-extrabold text-2xl leading-none tracking-tight text-site-primary lowercase">
+            tendpick
+          </span>
         </Link>
 
