+/**
+ * Top Ventes — sources multi-plateformes (30/09, refonte header/nav).
+ *
+ * Pas de colonne dédiée en base : la plateforme d'un produit est déduite
+ * de son affiliate_url (déjà présente sur chaque produit), ce qui évite
+ * une migration et garde une seule source de vérité.
+ */
+
+export type TopVentesSource = 'amazon' | 'rakuten' | 'aliexpress';
+
+export interface TopVentesSourceMeta {
+  key: TopVentesSource;
+  label: string;
+  icon: string;
+}
+
+export const TOP_VENTES_SOURCES: TopVentesSourceMeta[] = [
+  { key: 'amazon', label: 'Amazon', icon: '📦' },
+  { key: 'rakuten', label: 'Rakuten', icon: '🛍️' },
+  { key: 'aliexpress', label: 'AliExpress', icon: '🚀' },
+];
+
+/**
+ * Déduit la plateforme depuis le nom d'hôte de l'URL d'affiliation.
+ * Retourne null si l'URL est absente, invalide, ou d'une plateforme pas
+ * encore reconnue (ex. future source ajoutée au registre d'intégrations
+ * mais pas encore ici) — le produit est alors simplement exclu du filtre
+ * par source sans faire planter la page.
+ */
+export function getProductSource(affiliateUrl: string | null | undefined): TopVentesSource | null {
+  if (!affiliateUrl) return null;
+  try {
+    const host = new URL(affiliateUrl).hostname.toLowerCase();
+    if (host.includes('amazon.')) return 'amazon';
+    if (host.includes('rakuten.')) return 'rakuten';
+    if (host.includes('aliexpress.')) return 'aliexpress';
+    return null;
+  } catch {
+    return null;
+  }
+}
