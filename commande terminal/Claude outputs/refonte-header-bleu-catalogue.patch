+-- Catégories de navigation catalogue (30/09, refonte header "Confiance
+-- moderne" + menu site). Une ligne = une catégorie, traduite fr/es/uk —
+-- pas de catégorie par marché. is_active permet de la masquer côté public
+-- (nav, accueil, /produits, /c/[slug]) sans supprimer les produits qui y
+-- sont déjà rattachés.
+--
+-- "Top Ventes" (Amazon/Rakuten/AliExpress) N'EST PAS une catégorie stockée
+-- ici : c'est un filtre transversal calculé depuis products.affiliate_url
+-- (voir lib/top-ventes.ts) — décision Jerome, pas dupliqué en base.
+
+CREATE TABLE IF NOT EXISTS categories (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  slug text NOT NULL UNIQUE,
+  name_fr text NOT NULL,
+  name_es text NOT NULL,
+  name_uk text NOT NULL,
+  icon text,
+  sort_order integer NOT NULL DEFAULT 0,
+  is_active boolean NOT NULL DEFAULT true,
+  created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS idx_categories_active ON categories(is_active);
+
+ALTER TABLE categories ENABLE ROW LEVEL SECURITY;
+
+-- RLS calquée sur le reste du projet (Sprint 0, 18/09) : service_role
+-- uniquement, aucun accès direct depuis le client public (les pages
+-- publiques lisent via getSupabaseAdmin(), côté serveur).
+DROP POLICY IF EXISTS "service_role_all_categories" ON categories;
+CREATE POLICY "service_role_all_categories" ON categories
+  FOR ALL USING (auth.role() = 'service_role');
+
+-- Rattachement produit → catégorie, nullable (un produit non classé reste
+-- visible dans le catalogue général, juste absent des pages /c/[slug]).
+ALTER TABLE products ADD COLUMN IF NOT EXISTS category_id uuid REFERENCES categories(id);
+CREATE INDEX IF NOT EXISTS idx_products_category_id ON products(category_id);
+
+-- Seed : les 8 catégories validées par Jerome (27-28/09), conservées
+-- telles quelles plutôt que réduites. Idempotent (ON CONFLICT DO NOTHING)
+-- pour pouvoir rejouer la migration sans dupliquer si déjà présentes.
+INSERT INTO categories (slug, name_fr, name_es, name_uk, icon, sort_order) VALUES
+  ('best-of-amazon',       'Best of Amazon',          'Best of Amazon',                 'Best of Amazon',            '🏆', 1),
+  ('tech-gadgets',         'Tech & Gadgets',          'Tecnología y Gadgets',           'Tech & Gadgets',            '💻', 2),
+  ('mode-beaute',          'Mode & Beauté',           'Moda y Belleza',                 'Fashion & Beauty',          '👗', 3),
+  ('maison-deco',          'Maison & Déco',           'Hogar y Decoración',             'Home & Decor',              '🏠', 4),
+  ('sport-bien-etre',      'Sport & Bien-être',       'Deporte y Bienestar',            'Sport & Wellness',          '🏃', 5),
+  ('gaming-casino-paris',  'Gaming, Casino & Paris',  'Gaming, Casino y Apuestas',      'Gaming, Casino & Betting',  '🎮', 6),
+  ('art-design',           'Art & Design',            'Arte y Diseño',                  'Art & Design',              '🎨', 7),
+  ('loisirs',              'Loisirs',                 'Ocio',                           'Leisure',                   '🎯', 8)
+ON CONFLICT (slug) DO NOTHING;
