+
   const ip = getIp(req);
   const ipHash = hashIp(ip);
-  const userAgent = req.headers.get('user-agent') || null;
   const referer = req.headers.get('referer') || null;
 
-  await supabaseAdmin.from('page_views').insert({
-    product_id: productId,
-    ip_hash: ipHash,
-    user_agent: userAgent,
-    referer: referer,
-  });
+  await supabaseAdmin
+    .from('page_views')
