+
+interface Props {
+  categories: Category[];
+  market: Market;
+}
+
+function categoryName(c: Category, market: Market): string {
+  if (market === 'es') return c.name_es;
+  if (market === 'uk') return c.name_uk;
+  return c.name_fr;
+}
+
